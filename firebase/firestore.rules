rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function site() { return get(/databases/$(database)/documents/settings/site).data; }
    function isAdmin() { return signedIn() && request.auth.uid in site().admins; }
    function validPlan(code) {
      return code in ['vibe-coding-pack4', 'vibe-coding-single', 'vibe-coding-group',
                      'automation-pack4',  'automation-single',  'automation-group',
                      'ai-content-pack4',  'ai-content-single',  'ai-content-group'];
    }

    // 사이트 설정: 누구나 읽기, 쓰기는 콘솔에서만 (freePeriod: bool, admins: [uid])
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // 회원 프로필: 본인만 (운영자는 읽기)
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // 신청(수강권): 문서 id = uid_planCode 라서 같은 구성은 한 번만 만들어진다
    match /enrollments/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && site().freePeriod == true
        && id == request.auth.uid + '_' + request.resource.data.planCode
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'free'
        && request.resource.data.amount == 0
        && validPlan(request.resource.data.planCode)
        && request.resource.data.planCode.matches(request.resource.data.courseId + '-(pack4|single|group)')
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'courseId', 'planCode', 'amount', 'status', 'createdAt']);
      allow update: if isAdmin();   // 상태 변경(done 등)은 운영자만
      allow delete: if isAdmin();
    }
  }
}
